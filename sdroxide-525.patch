+
+impl TwoTone {
+    const HZ: [f32; 2] = [700.0, 1900.0];
+
+    fn step(&mut self) -> [f32; 2] {
+        let now = self.ph;
+        for (p, hz) in self.ph.iter_mut().zip(Self::HZ) {
+            *p += std::f32::consts::TAU * hz / TX_MONITOR_RATE as f32;
