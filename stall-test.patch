diff --git a/crates/sdroxide-proto/src/lib.rs b/crates/sdroxide-proto/src/lib.rs
index a55c4147..ef4a4dcc 100644
--- a/crates/sdroxide-proto/src/lib.rs
+++ b/crates/sdroxide-proto/src/lib.rs
@@ -1728,7 +1728,11 @@ use sdroxide_types::{
 /// its tail, and the radio configuration rides whole in both a command and an
 /// event, so a v211 peer reads the extra bytes as the start of the next field
 /// and fails to decode either.
-pub const PROTO_VERSION: u16 = 212;
+/// v213 (test build only; each PR bumps once on its own): TUNE can send a two-tone test signal (issue #525). `TxState` gains
+/// `two_tone` on its tail and `Command` gains a trailing `SetTuneTwoTone`;
+/// `TxState` rides whole inside `RadioState`, so a v212 peer reads the extra
+/// byte as the start of the next field and fails to decode every state.
